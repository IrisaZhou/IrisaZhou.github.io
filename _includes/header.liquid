<header class="site-header">
  <nav class="navbar container" aria-label="Main navigation">
    <a class="site-name" href="{{ '/' | relative_url }}">{{ site.title }}</a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-links">Menu</button>
    <div class="site-links" id="site-links">
      {% assign nav_pages = site.pages | where: 'nav', true | sort: 'nav_order' %}
      {% for item in nav_pages %}
        <a
          href="{{ item.url | relative_url }}"
          {% if page.url == item.url %}
            aria-current="page"
          {% endif %}
        >
          {{- item.title -}}
        </a>
      {% endfor %}
      <button class="theme-button" type="button" aria-label="Toggle dark mode">◐</button>
    </div>
  </nav>
</header>
<script>
  const menuButton = document.querySelector('.menu-button');
  menuButton.addEventListener('click', () => {
    const open = menuButton.getAttribute('aria-expanded') === 'true';
    menuButton.setAttribute('aria-expanded', String(!open));
    document.querySelector('.site-links').classList.toggle('open', !open);
  });
</script>
