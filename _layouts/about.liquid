---
layout: default
---
<article class="about">
  {% if page.profile %}
    <aside class="profile">
      <img src="{{ '/assets/img/' | append: page.profile.image | relative_url }}" alt="Irisa Zhou">
      <div class="more-info">{{ page.profile.more_info }}</div>
    </aside>
  {% endif %}
  <div class="about-content">{{ content }}</div>
</article>
