---
layout: default
---
{% if page._styles %}
  <style>
    {{ page._styles }}
  </style>
{% endif %}

<article class="page">
  <header class="post-header">
    <h1>{{ page.title }}</h1>
    {% if page.description %}
      <p class="description">{{ page.description }}</p>
    {% endif %}
  </header>
  {{ content }}
</article>
